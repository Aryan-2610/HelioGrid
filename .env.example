# ==============================================================================
# HelioGrid V1 - Environment Configuration Template
# ==============================================================================

# 1. ISRO VEDAS Solar Insolation API (Mandatory for Step 5)
VEDAS_API_KEY=your_vedas_api_key_here
VEDAS_WMS_URL=https://vedas.sac.gov.in/vapi/ridam_server3/wms/
VEDAS_SOLAR_LAYER=annual_insolation
VEDAS_DATASET_ID=T2S1P26
ENABLE_VEDAS_FALLBACK=true
FALLBACK_GHI=5.10

# 2. OpenStreetMap Nominatim Geocoding (Mandatory for Step 1)
NOMINATIM_USER_AGENT=HelioGridBasic/1.0
NOMINATIM_EMAIL=your_email@example.com

# 3. ISRO Bhuvan Portal (Optional Alternative)
BHUVAN_API_TOKEN=

# 4. Solar Sizing & PM Surya Ghar Constants (Pre-configured defaults from Design Doc)
SOLAR_USABLE_RATIO=0.65
SOLAR_SQM_PER_KW=8.0
SOLAR_PANEL_KW=0.545
SOLAR_PERFORMANCE_RATIO=0.78
SOLAR_COST_PER_KW=55000

# 5. FastAPI Backend Server & CORS Configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:8000
